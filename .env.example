# Ejemplo para DESARROLLO LOCAL. Copiar a .env y reemplazar valores.
# Nunca subir .env real a Git ni usar estas muestras en producción.
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=bookexpress_db
DB_USER=bookexpress_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SOLO PRODUCCIÓN: establecer tras verificar dominio, proxy y HTTPS.
# DEBUG=False
# SECRET_KEY=<generar_clave_aleatoria_de_50_o_mas_caracteres>
# ALLOWED_HOSTS=<dominio_real>
# CORS_ALLOWED_ORIGINS=https://<dominio_frontend_real>
# CSRF_TRUSTED_ORIGINS=https://<dominio_real>
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
